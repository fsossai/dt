#!/bin/bash -e

trap 'echo "error: $(basename $0): line $LINENO"; exit 1' ERR

if [[ -z $winchester_outDir ]]; then
  outDir=.
else
  outDir=$winchester_outDir
fi

cppstd=-std=c++20

if [[ $# < 1 || $# > 2 ]]; then
  echo "usage: `basename $0` <SOURCE> [<OUT_DIR>]"
  exit 1
fi

mkdir -p $outDir
installDir=$(realpath $(dirname $(realpath $0))/..)
ginoSrc=/nfs-scratch/fsv1684/gino-dt
noelleSrc=/nfs-scratch/fsv1684/noelle-dt
source $ginoSrc/enable
source $noelleSrc/enable

################################################################################
stage=0
echo "Winchester: Stage $stage"

source /project/gllvm/enable
gclang++ \
  -DNOELLE_PRAGMA_BODY_DISABLE \
  $cppstd \
  $winchester_flags \
  -fopenmp \
  -fno-exceptions \
  -fno-vectorize \
  -c \
  -O2 \
  -Xclang \
  -disable-llvm-passes \
  -I $(noelle-config --include) \
  -I /nfs-scratch/fsv1684/repo/dt/skynet \
  -o $outDir/s$((stage))_input.o \
  $@
get-bc -o $outDir/s$((stage))_input.bc $outDir/s$((stage))_input.o

################################################################################
((stage+=1))
echo "Winchester: Stage $stage"
opt --inline $outDir/s$((stage-1))_input.bc -o $outDir/s$((stage))_inlined.bc
noelle-norm $outDir/s$((stage))_inlined.bc -o $outDir/s$((stage))_inlined.bc
# noelle-meta-scc-embed $outDir/s$((stage))_inlined.bc -o scc.$outDir/s$((stage))_inlined.bc &
clang++ \
  $cppstd \
  -fopenmp \
  -c \
  -emit-llvm \
  -O3 \
  -I $ginoSrc/tests/include/threadpool/include \
  -I /nfs-scratch/fsv1684/repo/dt/skynet \
  -o $outDir/Parallelizer_utils.bc \
  $ginoSrc/src/core/runtime/Parallelizer_utils.cpp \
  2>&1
clang \
  -c \
  -emit-llvm \
  -O3 \
  -I $ginoSrc/tests/include/threadpool/include \
  -I /nfs-scratch/fsv1684/repo/dt/skynet \
  -o $outDir/NOELLE_APIs.bc \
  $ginoSrc/src/core/runtime/NOELLE_APIs.c \
  2>&1

################################################################################
((stage+=1))
echo "Winchester: Stage $stage"
gino-load  \
  -noelle-disable-dswp \
  -noelle-disable-helix \
  -load $installDir/lib/LoopBlocker.so \
  -load $installDir/lib/Terminator.so \
  -Terminator \
  --terminator-tagged-only=true \
  --terminator-func= \
  --terminator-details \
  --terminator-craft-plan \
  --terminator-breaks=-1 \
  --noelle-verbose=2 \
  -o $outDir/s$((stage))_terminated.bc \
  $outDir/s$((stage-1))_inlined.bc

noelle-norm $outDir/s$((stage))_terminated.bc -o $outDir/s$((stage))_terminated.bc
# noelle-meta-scc-embed $outDir/s$((stage))_terminated.bc -o scc.$outDir/s$((stage))_terminated.bc &

################################################################################
((stage+=1))
echo "Winchester: Stage $stage"
llvm-link \
  $outDir/s$((stage-1))_terminated.bc \
  $outDir/Parallelizer_utils.bc \
  $outDir/NOELLE_APIs.bc \
  -o $outDir/s$((stage))_linked.bc

################################################################################
((stage+=1))
echo "Winchester: Stage $stage"
noelle-norm $outDir/s$((stage-1))_linked.bc -o $outDir/s$((stage))_renormalized.bc

################################################################################
((stage+=1))
echo "Winchester: Stage $stage"
gino-loops $outDir/s$((stage-1))_renormalized.bc -o $outDir/s$((stage))_parallelized.bc

################################################################################
((stage+=1))
echo "Winchester: Stage $stage"
noelle-load -PragmaEraser $outDir/s$((stage-1))_parallelized.bc -o $outDir/s$((stage))_nopragma.bc

################################################################################
((stage+=1))
echo "Winchester: Stage $stage"
clang++ \
  $flags \
  -pthreads \
  -fopenmp \
  $outDir/s$((stage-1))_nopragma.bc \
  -o $outDir/s$((stage))_exe.out

wait
echo "Winchester: Done"
