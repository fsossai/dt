#!/bin/bash -e

trap 'echo "error: $(basename $0): line $LINENO"; exit 1' ERR

export PATH=@DT_INSTALL_DIR@/bin:$PATH
export LD_LIBRARY_PATH=@DT_INSTALL_DIR@/lib:$LD_LIBRARY_PATH

export PATH=$(@DT_INSTALL_DIR@/bin/gino-config --prefix)/bin:$PATH
export LD_LIBRARY_PATH=$(@DT_INSTALL_DIR@/bin/gino-config --prefix)/lib:$LD_LIBRARY_PATH

export PATH=$(@DT_INSTALL_DIR@/bin/noelle-config --prefix)/bin:$PATH
export LD_LIBRARY_PATH=$(@DT_INSTALL_DIR@/bin/noelle-config --prefix)/lib:$LD_LIBRARY_PATH

timer_file=$(mktemp)

lap_timer_init() {
  date +%s > "$timer_file"
}

lap_timer() {
  if [[ -f $timer_file ]]; then
    echo "Winchester: Stage $stage: Elapsed time: $(( $(date +%s) - $(<"$timer_file") ))s"
  fi
  date +%s > "$timer_file"
}

if [[ -z $winchester_outDir ]]; then
  outDir=.
else
  outDir=$winchester_outDir
fi

if [[ -z $winchester_frontend ]]; then
  winchester_frontend="-std=c++17"
fi

if [[ -z $winchester_inline ]]; then
  winchester_inline="yes"
fi

if [[ -z $winchester_profiler ]]; then
  winchester_profiler="no"
fi

if [[ -z $winchester_craftPlan ]]; then
  winchester_craftPlan="0"
fi

if [[ -z $winchester_interproc ]]; then
  winchester_interproc="false"
fi

if [[ -z $winchester_taggedOnly ]]; then
  winchester_taggedOnly="false"
fi

if [[ -z $winchester_forceBlockedScheduling ]]; then
  winchester_forceBlockedScheduling="false"
fi

if [[ -z $winchester_forceRuntimeScheduling ]]; then
  winchester_forceRuntimeScheduling="false"
fi

if [[ $# < 1 ]]; then
  cat <<EOF
usage: $(basename "$0") <SOURCES>

Set behavior through environment variables (all winchester_ parameters):
  winchester_outBin                   string default=""
  winchester_outDir                   string default="."
  winchester_frontend                 string default="-std=c++17"
  winchester_linker                   string default=""
  winchester_opt                      string default=""
  winchester_inline                   yes|no default="yes"
  winchester_profiler                 yes|no default="no"
  winchester_craftPlan                csv|0 default="0"
  winchester_interproc                true|false default="false"
  winchester_taggedOnly               true|false default="false"
  winchester_func                     string default=""
  winchester_forceBlockedScheduling   true|false default="false"
  winchester_forceRuntimeScheduling   true|false default="false"
EOF
  exit 1
fi

mkdir -p $outDir

lap_timer_init # timer initialization

################################################################################
stage=0
echo "Winchester: Stage $stage: Bitcode extraction"

gclang++ \
  -DNOELLE_PRAGMA_BODY_DISABLE \
  -L$(noelle-config --prefix)/lib \
  -Wl,-rpath=$(noelle-config --prefix)/lib \
  -lpragma \
  -lprofiler \
  $winchester_frontend \
  $winchester_linker \
  -fopenmp \
  -fno-exceptions \
  -fno-vectorize \
  -O3 \
  -Xclang \
  -disable-llvm-passes \
  -I $(noelle-config --include) \
  -I @DT_INSTALL_DIR@/include \
  -o $outDir/${winchester_outBin}_s${stage}_input.out \
  $@

get-bc -o $outDir/${winchester_outBin}_s${stage}_input.bc $outDir/${winchester_outBin}_s${stage}_input.out
noelle-norm $outDir/${winchester_outBin}_s${stage}_input.bc -o $outDir/${winchester_outBin}_s${stage}_input.bc

if [[ $winchester_profiler == "yes" ]]; then
  echo "Winchester: Profiler enabled"
  noelle-profiler \
    -profiler-no-std \
    -profiler-no-demangle \
    -o $outDir/${winchester_outBin}_s${stage}_input.bc \
    $outDir/${winchester_outBin}_s${stage}_input.bc
fi

lap_timer

if [[ $winchester_craftPlan != "0" ]]; then
  echo $winchester_craftPlan | sed 's/,/\n/g' | while read tag; do
    gino-load  \
      -disable-output \
      -noelle-disable-dswp \
      -noelle-disable-helix \
      -load @DT_INSTALL_DIR@/lib/Terminator.so \
      -load @DT_INSTALL_DIR@/lib/Dot.so \
      -dot-output="$outDir/${winchester_outBin}_s${stage}_tag${tag}.dot" \
      -dot-tag=$tag \
      -Dot \
      $outDir/${winchester_outBin}_s${stage}_input.bc
    gino-load  \
      -disable-output \
      -noelle-disable-dswp \
      -noelle-disable-helix \
      -load @DT_INSTALL_DIR@/lib/Terminator.so \
      -load @DT_INSTALL_DIR@/lib/Dot.so \
      -dot-output="$outDir/${winchester_outBin}_s${stage}_tag${tag}_term.dot" \
      -dot-tag=$tag \
      -dot-term \
      -Dot \
      $outDir/${winchester_outBin}_s${stage}_input.bc
  done
fi

################################################################################
stage=1
echo "Winchester: Stage $stage: Inlining & Global DCE"
echo "Winchester: Inline: $winchester_inline"
if [[ $winchester_inline == "yes" ]]; then
  inline="--inline"
else
  inline=""
fi
opt $inline --internalize-public-api-list=main --internalize --globaldce $outDir/${winchester_outBin}_s$((stage-1))_input.bc -o $outDir/${winchester_outBin}_s${stage}_inlined.bc

noelle-norm $outDir/${winchester_outBin}_s${stage}_inlined.bc -o $outDir/${winchester_outBin}_s${stage}_inlined.bc
clang++ \
  -fno-exceptions \
  -fopenmp \
  -std=c++17 \
  -c \
  -emit-llvm \
  -O3 \
  -I @DT_INSTALL_DIR@/include/skynet \
  -o $outDir/runtime_def.bc \
  $(gino-config --runtime-def) \
  2>&1
clang \
  -c \
  -emit-llvm \
  -O3 \
  -I @DT_INSTALL_DIR@/include/skynet \
  -o $outDir/runtime_decl.bc \
  $(gino-config --runtime-decl) \
  2>&1
lap_timer

if [[ $winchester_craftPlan != "0" ]]; then
  echo $winchester_craftPlan | sed 's/,/\n/g' | while read tag; do
    gino-load  \
      -disable-output \
      -noelle-disable-dswp \
      -noelle-disable-helix \
      -load @DT_INSTALL_DIR@/lib/Terminator.so \
      -load @DT_INSTALL_DIR@/lib/Dot.so \
      -dot-output="$outDir/${winchester_outBin}_s${stage}_tag${tag}.dot" \
      -dot-tag=$tag \
      -Dot \
      $outDir/${winchester_outBin}_s${stage}_inlined.bc
  done
fi

################################################################################
stage=2
echo "Winchester: Stage $stage: Termination"
gino-load  \
  -noelle-disable-dswp \
  -noelle-disable-helix \
  -load @DT_INSTALL_DIR@/lib/LoopBlocker.so \
  -load @DT_INSTALL_DIR@/lib/Terminator.so \
  -Terminator \
  --terminator-tagged-only=${winchester_taggedOnly} \
  --terminator-func=${winchester_func} \
  --terminator-details \
  --terminator-craft-plan=${winchester_craftPlan} \
  --terminator-interproc=${winchester_interproc} \
  --force-blocked-scheduling=${winchester_forceBlockedScheduling} \
  --force-runtime-scheduling=${winchester_forceRuntimeScheduling} \
  --terminator-breaks=-1 \
  --noelle-verbose=0 \
  -o $outDir/${winchester_outBin}_s${stage}_terminated.bc \
  $outDir/${winchester_outBin}_s$((stage-1))_inlined.bc

noelle-norm $outDir/${winchester_outBin}_s${stage}_terminated.bc -o $outDir/${winchester_outBin}_s${stage}_terminated.bc
lap_timer

################################################################################
stage=3
echo "Winchester: Stage $stage: Linking runtime"
llvm-link \
  $outDir/${winchester_outBin}_s$((stage-1))_terminated.bc \
  $outDir/runtime_decl.bc \
  $outDir/runtime_def.bc \
  -o $outDir/${winchester_outBin}_s${stage}_linked.bc
lap_timer

################################################################################
stage=4
echo "Winchester: Stage $stage: Renormalization"
noelle-norm $outDir/${winchester_outBin}_s$((stage-1))_linked.bc -o $outDir/${winchester_outBin}_s${stage}_renormalized.bc
lap_timer

################################################################################
stage=5
echo "Winchester: Stage $stage: Parallelization"
gino-loops $outDir/${winchester_outBin}_s$((stage-1))_renormalized.bc -o $outDir/${winchester_outBin}_s${stage}_parallelized.bc
lap_timer

################################################################################
stage=6
echo "Winchester: Stage $stage: Pragma erasure"
noelle-load -PragmaEraser $outDir/${winchester_outBin}_s$((stage-1))_parallelized.bc -o $outDir/${winchester_outBin}_s${stage}_nopragma.bc
lap_timer

################################################################################
stage=7
echo "Winchester: Stage $stage: Binary generation"
opt \
  $winchester_opt \
  $outDir/${winchester_outBin}_s$((stage-1))_nopragma.bc \
  -o $outDir/${winchester_outBin}_s${stage}_exe.bc

if [[ $winchester_profiler == "yes" ]]; then
  profiler_linker="-L$(noelle-config --prefix)/lib -lprofiler"
fi

clang++ \
  $winchester_linker \
  $profiler_linker \
  $winchester_opt \
  -pthread \
  -fopenmp \
  $outDir/${winchester_outBin}_s${stage}_exe.bc \
  -o $outDir/${winchester_outBin}_s${stage}_exe.out

sleep 0.5

if [[ -n $winchester_outBin ]]; then
  cp $outDir/${winchester_outBin}_s${stage}_exe.out $outDir/$winchester_outBin
fi
lap_timer

echo "Winchester: Done"
